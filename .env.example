# PostgreSQL container configuration
POSTGRES_USER=nusapolicy
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=nusapolicy
POSTGRES_PORT=5432

# API configuration (Google AI Studio / Gemini API)
DATABASE_URL=postgresql+psycopg://nusapolicy:change-me-for-local-development@db:5432/nusapolicy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Browser-accessible API origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/User-Galih/nusapolicy-copilot
