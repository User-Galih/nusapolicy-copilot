# PostgreSQL container configuration
POSTGRES_USER=nusapolicy
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=nusapolicy
POSTGRES_PORT=5432

# API configuration
DATABASE_URL=postgresql+psycopg://nusapolicy:change-me-for-local-development@db:5432/nusapolicy
NINEROUTER_URL=http://host.docker.internal:20128
NINEROUTER_API_KEY=
NINEROUTER_MODEL=master-fallback
NINEROUTER_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small

# Browser-accessible API origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_REPOSITORY_URL=
